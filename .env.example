# GEMINI_API_KEY: Required for Gemini AI API calls and search result reranking.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Site Search Agent Configuration ---

# SerpAPI Key for Google / Yandex site: query delegation (Strategy 1)
SERPAPI_KEY=

# Local SQLite / libSQL database URL for site crawling & FTS indexing
CRAWL_DB_URL="file:./data/site-agent.db"

# Custom User-Agent header for crawler & sitemap fetching
CRAWL_USER_AGENT="SiteAgent/1.0 (+https://ais.studio)"

# Default crawl limits
CRAWL_MAX_PAGES=500
CRAWL_MAX_DEPTH=4
CRAWL_DELAY_MS=200

# Toggle search strategies independently
ENABLE_OPERATOR_STRATEGY=true
ENABLE_CRAWL_STRATEGY=true
ENABLE_INDEX_STRATEGY=true
ENABLE_NATIVE_STRATEGY=true

# Optional Meilisearch Integration (Strategy 3 fallback)
MEILI_ENABLED=false
MEILI_HOST="http://localhost:7700"
MEILI_KEY=""

